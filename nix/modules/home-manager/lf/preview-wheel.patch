+package main
+
+import "sync/atomic"
+
+// Each window has a full viewport plus one block and a lookahead line.
+const previewBlock = 64
+
+type previewWindow struct {
+	path  string
+	first int
+}
+
+type previewScroll struct {
+	// The UI owns offset. The worker takes an immutable snapshot of window.
+	offset int
+	window atomic.Pointer[previewWindow]
+	count  *previewLineCount
+}
+
+func (s *previewScroll) reset() {
+	s.cancelLineCount()
+	s.offset = 0
+	s.window.Store(nil)
+}
+
+func (s *previewScroll) first(path string) int {
+	if w := s.window.Load(); w != nil && w.path == path {
+		return w.first
+	}
+	return 0
+}
+
+// move returns true only when the worker must render a different window.
+// Keep incoming wheel deltas while it runs; clamp to EOF once it is known.
+func (s *previewScroll) move(r *reg, delta int) bool {
+	if r == nil || r.loading || !r.paged || r.sixel || r.height == 0 {
+		return false
+	}
+	s.offset = max(0, s.offset+delta)
+	bottom := r.first + max(0, len(r.lines)-r.height)
+	if len(r.lines) < r.height+previewBlock+1 {
+		s.offset = min(s.offset, bottom)
+	}
+	if r.first > 0 && len(r.lines) < r.height {
+		// The file shrank or the pane grew while this window was loading.
+		s.offset = 0
+	}
+	first := r.first
+	switch {
+	case s.offset < r.first:
+		first = max(0, s.offset-previewBlock/2)
+	case s.offset > bottom:
+		first = bottom - previewBlock/2 // overlapping windows allow a reversal without another read
+	}
+	if first == s.first(r.path) {
+		return false
+	}
+	s.window.Store(&previewWindow{path: r.path, first: first})
+	return true
+}
