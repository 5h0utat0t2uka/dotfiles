@@ -0,0 +1,123 @@
+package main
+
+import (
+	"bytes"
+	"io"
+	"math"
+	"os"
+	"sync/atomic"
+
+	"github.com/gdamore/tcell/v3"
+)
+
+// Position the thumb using the rows actually on screen, including while the
+// preview worker is still fetching the window requested by a wheel event.
+func (r *reg) visibleTop(offset, height int) int {
+	return min(max(0, offset-r.first), max(0, len(r.lines)-height))
+}
+
+func scrollbarThumb(height, offset int, lines int64) (start, size int) {
+	if height < 2 || lines <= int64(height) {
+		return 0, 0
+	}
+	size = max(1, int(int64(height)*int64(height)/lines))
+	last := lines - int64(height)
+	progress := float64(min(max(0, int64(offset)), last)) / float64(last)
+	return int(math.Round(progress * float64(height-size))), size
+}
+
+func (ui *ui) drawPreviewScrollbar(nav *nav) {
+	f := nav.currFile()
+	if f == nil {
+		return
+	}
+	r := nav.regCache[f.path]
+	if r == nil || !r.paged || r.loading || r.sixel {
+		return
+	}
+	pane := ui.wins[len(ui.wins)-1]
+	if pane.h < 2 || pane.w < 1 {
+		return
+	}
+	total := int64(r.first + len(r.lines))
+	if len(r.lines) >= r.height+previewBlock+1 {
+		// This window did not reach EOF. Count in the background once.
+		total = nav.scroll.totalLines(f, ui.exprChan)
+	}
+	offset := r.first + r.visibleTop(nav.scroll.offset, pane.h)
+	start, size := scrollbarThumb(pane.h, offset, total)
+	for row := start; row < start+size; row++ {
+		ui.screen.PutStrStyled(pane.x+pane.w, pane.y+row, " ", tcell.StyleDefault.Reverse(true))
+	}
+}
+
+type previewLineCount struct {
+	info  os.FileInfo
+	stop  chan struct{}
+	lines atomic.Int64
+}
+
+func (s *previewScroll) cancelLineCount() {
+	if s.count != nil {
+		close(s.count.stop)
+		s.count = nil
+	}
+}
+
+func (c *previewLineCount) matches(info os.FileInfo) bool {
+	return os.SameFile(c.info, info) && c.info.Size() == info.Size() && c.info.ModTime().Equal(info.ModTime())
+}
+
+func (s *previewScroll) totalLines(f *file, redraw chan<- expr) int64 {
+	if s.count != nil && s.count.matches(f.FileInfo) {
+		return s.count.lines.Load()
+	}
+	s.cancelLineCount()
+	c := &previewLineCount{info: f.FileInfo, stop: make(chan struct{})}
+	s.count = c
+	go func(path string) {
+		input, err := os.Open(path)
+		if err != nil {
+			return
+		}
+		defer input.Close()
+		lines := countPreviewLines(input, c.stop)
+		info, err := input.Stat()
+		if lines < 0 || err != nil || !c.matches(info) {
+			return
+		}
+		c.lines.Store(lines)
+		select {
+		case redraw <- &callExpr{"draw", nil, 1}:
+		case <-c.stop:
+		}
+	}(f.path)
+	return 0
+}
+
+func countPreviewLines(reader io.Reader, stop <-chan struct{}) int64 {
+	var lines int64
+	last := byte('\n')
+	buf := make([]byte, 64*1024)
+	for {
+		select {
+		case <-stop:
+			return -1
+		default:
+		}
+		n, err := reader.Read(buf)
+		if n > 0 {
+			lines += int64(bytes.Count(buf[:n], []byte{'\n'}))
+			last = buf[n-1]
+		}
+		if err == io.EOF {
+			if last != '\n' {
+				lines++
+			}
+			return lines
+		}
+		if err != nil {
+			return -1
+		}
+	}
+}
