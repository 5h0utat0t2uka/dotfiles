+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestScrollPreviewBurst(t *testing.T) {
+	var s previewScroll
+	r := &reg{path: "a", paged: true, height: 10, lines: make([]string, 10+previewBlock+1)}
+	for range previewBlock {
+		if s.move(r, 1) {
+			t.Fatal("scroll inside a cached window requested another render")
+		}
+	}
+	if !s.move(r, 6) || s.offset != 70 {
+		t.Fatal("crossing the window boundary did not schedule a read")
+	}
+	if s.move(r, 2) || s.offset != 72 {
+		t.Fatal("lost a wheel delta while the next window was loading")
+	}
+	r.first = s.first(r.path)
+	r.lines = make([]string, 78-r.first) // final window of a 78-line file
+	if s.move(r, 0) || s.offset != 68 || s.move(r, 1) || s.offset != 68 {
+		t.Fatal("last viewport should be clamped at EOF")
+	}
+	if s.move(r, -1) || s.offset != 67 {
+		t.Fatal("reversing direction should use the same window")
+	}
+	s.reset()
+	if s.offset != 0 || s.first("a") != 0 {
+		t.Fatal("selection change must reset the viewport")
+	}
+}
+
+func TestScrollbarThumb(t *testing.T) {
+	for _, tc := range []struct{ height, offset, lines, start, size int }{
+		{20, 0, 0, 0, 0},       // total still being counted
+		{20, 0, 20, 0, 0},      // fits in the pane
+		{20, 0, 100, 0, 4},     // first viewport
+		{20, 40, 100, 8, 4},    // middle viewport
+		{20, 80, 100, 16, 4},   // last viewport
+		{5, 1000, 1000, 4, 1},  // at least one cell, clamp at the bottom
+	} {
+		start, size := scrollbarThumb(tc.height, tc.offset, int64(tc.lines))
+		if start != tc.start || size != tc.size {
+			t.Errorf("%+v: got start=%d size=%d", tc, start, size)
+		}
+	}
+}
+
+func TestCountPreviewLines(t *testing.T) {
+	for _, tc := range []struct {
+		text string
+		want int64
+	}{
+		{"", 0}, {"\n\n", 2}, {"one\ntwo\n", 2}, {"one\ntwo", 2},
+		{strings.Repeat("x", 64*1024) + "\nend", 2},
+	} {
+		if got := countPreviewLines(strings.NewReader(tc.text), nil); got != tc.want {
+			t.Errorf("input length %d: got %d lines, want %d", len(tc.text), got, tc.want)
+		}
+	}
+	stop := make(chan struct{})
+	close(stop)
+	if got := countPreviewLines(strings.NewReader("unfinished"), stop); got != -1 {
+		t.Errorf("canceled count returned %d", got)
+	}
+}
